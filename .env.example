# Configuration facultative. Copier en `.env` si besoin.
# Le dépôt GitHub se connecte normalement depuis l'interface (Réglages) : ces valeurs ne servent
# qu'au premier démarrage, tant qu'aucun réglage n'a été enregistré (data/config.json).

PORT=3000

# Préconfiguration d'un dépôt GitHub (facultatif)
# GITHUB_TOKEN=
# GITHUB_REPO=proprietaire/depot
# GITHUB_BRANCH=main

# Dossiers de données (facultatif)
# DATA_DIR=./data
# LOCAL_REPO_DIR=./data/localrepo

# Réglages fins (facultatif)
# AUTOSAVE_MS=5000
# POLL_MS=20000
