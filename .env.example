# Copie ce fichier en `.env` puis renseigne tes valeurs.

# Port HTTP de l'interface
PORT=3000

# ---- Mode GitHub (recommandé pour collaborer avec Claude) ----
# Une fois renseigné, GameVault lit/écrit ce dépôt via l'API GitHub.
# Crée un token « Personal Access Token » (classique, scope repo) ici :
#   https://github.com/settings/tokens
GITHUB_TOKEN=
# Dépôt cible, au format proprietaire/repo (ex: Anthanaab/mon-jeu)
GITHUB_REPO=
# Branche de travail
GITHUB_BRANCH=main

# ---- Mode local (auto-hébergé pur, sans GitHub) ----
# Utilisé seulement si GITHUB_TOKEN est vide. Dépôt git local pour tes docs.
LOCAL_REPO_DIR=./data/localrepo