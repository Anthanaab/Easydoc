{
  "name": "easydoc",
  "version": "0.4.0",
  "description": "Éditeur Markdown collaboratif en temps réel, auto-hébergé, adossé à un dépôt GitHub.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild client/libs.js --bundle --format=esm --minify --target=es2020 --legal-comments=none --outfile=public/vendor/libs.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "simple-git": "^3.25.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^0.12.2",
    "ws": "^8.18.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "esbuild": "^0.24.2",
    "marked": "^12.0.2"
  }
}
