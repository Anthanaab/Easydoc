{
  "name": "easydoc",
  "version": "0.17.0",
  "description": "Éditeur Markdown collaboratif en temps réel, auto-hébergé, adossé à un dépôt GitHub.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "build": "esbuild client/libs.js --bundle --format=esm --minify --target=es2020 --legal-comments=none --outfile=public/vendor/libs.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "diff": "^5.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "simple-git": "^4.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.9.1",
    "ws": "^8.18.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.24.2",
    "y-codemirror.next": "^0.3.6"
  }
}
